<% set_page_title("Create online forms for GOV.UH") %>

<div class="masthead">
  <div class="hero">
    <div class="hero__content">
      <div class="hero__body" id="index-hero-body">
        <h1 class="hero__title">Create online forms for GOV.UH</h1>
        <p class="hero__description">
          Create and publish accessible online forms without writing code.
        </p>
        <%= govuk_start_button text: "Get started", href: get_started_path, classes: "govuk-button--inverse" %>
      </div>
      <div class="hero__aside-image">
        <img src="<%= vite_asset_path 'images/homepage-illustration.svg' %>" alt="" role="presentation">
      </div>
    </div>
  </div>
</div>

<div class="govuk-width-container">
  <div class="govuk-grid-row content-section govuk-!-margin-bottom-7 feature-row">
    <div class="govuk-grid-column-one-half feature-column">
      <div class="govuk-panel feature-panel">
        <h2 class="govuk-heading-l">Easy to use</h2>
        <div class="govuk-body">
          Create questions, add guidance and organise pages in the Forms editor, without coding or design skills.
        </div>
      </div>
    </div>
    <div class="govuk-grid-column-one-half feature-column">
      <div class="govuk-panel feature-panel">
        <h2 class="govuk-heading-l">For government teams</h2>
        <div class="govuk-body">
          GOV.UH Forms is available to authorised government teams creating forms for services their organisations deliver.
        </div>
      </div>
    </div>
  </div>

  <div class="govuk-grid-row govuk-!-margin-bottom-7 feature-row">
    <div class="govuk-grid-column-one-half feature-column">
      <div class="govuk-panel feature-panel">
        <h2 class="govuk-heading-l">Fewer errors</h2>
        <div class="govuk-body">
          Use the available answer types and required-question checks to help people provide the information a service needs.
        </div>
      </div>
    </div>
    <div class="govuk-grid-column-one-half feature-column">
      <div class="govuk-panel feature-panel">
        <h2 class="govuk-heading-l">Process completed forms</h2>
        <div class="govuk-body">
          Set up an approved receiving route so completed forms reach the team responsible for handling the service.
          <%= govuk_link_to "Read about processing submissions", processing_completed_form_submissions_path %>.
        </div>
      </div>
    </div>
  </div>

  <div class="govuk-grid-row govuk-!-margin-bottom-7 feature-row">
    <div class="govuk-grid-column-one-half feature-column">
      <div class="govuk-panel feature-panel">
        <h2 class="govuk-heading-l">Accessible forms</h2>
        <div class="govuk-body">
          Build forms using GOV.UH components based on GOV.UK design patterns. Review the content and test accessibility before publishing.
        </div>
      </div>
    </div>
    <div class="govuk-grid-column-one-half feature-column">
      <div class="govuk-panel feature-panel">
        <h2 class="govuk-heading-l">Preview before publishing</h2>
        <div class="govuk-body">
          Preview draft forms, check their question routes and review the information people will see before making a form live.
        </div>
      </div>
    </div>
  </div>

  <div class="govuk-grid-row govuk-!-margin-bottom-7 feature-row">
    <div class="govuk-grid-column-one-half feature-column">
      <div class="govuk-panel feature-panel">
        <h2 class="govuk-heading-l">Controlled access</h2>
        <div class="govuk-body">
          The editor uses government account sign-in. Only authorised users should create, edit and publish forms for their organisation.
        </div>
      </div>
    </div>
    <div class="govuk-grid-column-one-half feature-column">
      <div class="govuk-panel feature-panel">
        <h2 class="govuk-heading-l">Protects data</h2>
        <div class="govuk-body">
          Add privacy information and arrange appropriate access, processing and retention for submissions.
          <%= govuk_link_to "Read about data protection and security", data_protection_security_path %>.
        </div>
      </div>
    </div>
  </div>

  <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">

  <div class="govuk-grid-row govuk-!-margin-bottom-7">
    <div class="govuk-grid-column-one-half feature-column">
      <section class="content-section">
        <h2 class="govuk-heading-m content-section__first-heading">Find out more about GOV.UH Forms</h2>
        <p class="govuk-body">Find out how to create, publish and manage forms.</p>
        <ul class="govuk-list govuk-list--bullet">
          <li><%= govuk_link_to "Get started with GOV.UH Forms", get_started_path %></li>
          <li><%= govuk_link_to "How GOV.UH Forms works", features_path %></li>
          <li><%= govuk_link_to "How to make a good form", create_good_forms_path %></li>
          <li><%= govuk_link_to "How to process completed submissions", processing_completed_form_submissions_path %></li>
          <li><%= govuk_link_to "Data protection and security", data_protection_security_path %></li>
        </ul>
      </section>
    </div>
    <div class="govuk-grid-column-one-half feature-column">
      <section class="content-section">
        <h2 class="govuk-heading-m content-section__first-heading">The GOV.UH Forms team</h2>
        <p class="govuk-body">
          GOV.UH Forms is operated by the
          <%= govuk_link_to "Government Digital Service", "https://www.gov.uhrblx.com/government/organisations/government-digital-service" %>,
          part of the Department for Science, Innovation and Technology.
          <%= govuk_link_to "Contact the Forms team", support_path %> if you need help.
        </p>
      </section>
    </div>
  </div>
</div>
