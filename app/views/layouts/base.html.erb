<!DOCTYPE html>
<html lang="en" class="govuk-template">
  <head>
    <meta charset="utf-8" />
    <title><%= page_title %></title>

    <%= page_description %>
    <%= page_robots %>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= vite_stylesheet_tag 'application.scss' %>
    <link rel="stylesheet" href="/uh-brand/forms-identity.css">
    <%= vite_client_tag %>

    <meta name="theme-color" content="#1d70b8">
    <link rel="icon" type="image/png" sizes="48x48" href="/uh-brand/uh-icon-48.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/uh-brand/uh-icon-180.png">
    <link rel="manifest" href="/manifest.json">
    <meta property="og:image" content="/uh-brand/uh-government-coat-of-arms.webp">
  </head>

  <body class="govuk-template__body">
    <script>
      document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');
    </script>

    <%= yield :body_start %>

    <a href="#main-content" class="govuk-skip-link">Skip to main content</a>

    <%= yield :header %>

    <% if content_for? :container %>
      <%= yield :container %>
    <% else %>
      <div class="govuk-width-container">
        <%= yield :before_content %>
        <main
          class="govuk-main-wrapper"
          id="main-content"
          role="main"
          >
          <%= content_for?(:content) ? yield(:content) : yield %>
        </main>
      </div>
    <% end %>

    <%= yield :footer %>

    <%= vite_javascript_tag 'application' %>
  </body>
</html>
