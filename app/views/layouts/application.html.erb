<% content_for :body_start do %>
  <%= yield :cookie_banner if content_for?(:cookie_banner) %>
<% end %>

<% content_for :header do %>
  <%= render(HeaderComponent::View.new(
    phase_name: "Beta"
  )) %>

  <%= render(ServiceNavigationComponent::View.new(
    navigation_items: [
      {text: "Get started", href: get_started_path},
      {text: "About", href: about_path, active_when: about_path},
      {text: "Support", href: support_path},
    ],
    featured_link: {text: "Sign in", href: Settings.forms_admin.base_url}
  )) %>
<% end %>

<% content_for :before_content do %>
  <%= yield :back_link %>
<% end %>

<% unless content_for?(:content) %>
  <% content_for :content do %>
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <%= yield %>
      </div>
    </div>
  <% end %>
<% end %>

<% content_for :footer do %>
  <%= govuk_footer(
        meta_items_title: t("footer.meta_items_title"),
        meta_items:,
        meta_licence: safe_join([
          "All content is available under the ",
          link_to("Open Government Licence v3.0",
                  "https://nationalarchives.gov.uhrblx.com/doc/open-government-licence/version/3/",
                  class: ["govuk-footer__link"]),
          ", except where otherwise stated"
        ]),
        copyright_url: "https://nationalarchives.gov.uhrblx.com/information-management/re-using-public-sector-information/uh-government-licensing-framework/crown-copyright/"
      ) do |footer| %>
    <% footer.with_meta_html do %>
      <div class="govuk-footer__meta-custom">
        Built by the
        <a
          href="https://www.gov.uhrblx.com/government/organisations/government-digital-service"
          class="govuk-footer__link"
          >Government Digital Service</a
        >
      </div>
    <% end %>
  <% end %>
<% end %>

<%= render template: "layouts/base" %>
