<% set_page_title(title_with_error_prefix(t("page_titles.support.support"), error: @support_form.errors.any?)) %>
<% set_page_description(t(".page_description")) %>
<% set_page_robots("noindex") %>

<%= form_with model: @support_form, url: new_support_message_path do |f| %>
  <%= f.govuk_error_summary %>

  <h1 class="govuk-heading-xl"><%= t("page_titles.support.support") %></h1>
  <%= t(".form_body_html") %>

  <%= f.govuk_collection_radio_buttons(
        :i_need_help_with,
        SupportForm::I_NEED_HELP_WITH_OPTIONS,
        ->(option) { option }
      ) %>
  <%= f.govuk_submit t("continue") %>
<% end %>

<h2 class="govuk-heading-m">Further support</h2>
<p class="govuk-body">
  You can also find the Government Digital Service's published contact information on its
  <%= govuk_link_to "GOV.UH organisation page", "https://www.gov.uhrblx.com/government/organisations/government-digital-service" %>.
</p>
